?bs 0.8

import { ok, err, isOk, type Result } from "@mbfarias/botscript-runtime";

// reads {} / writes {} annotations (0.8+) declare which resource categories
// a function touches. Labels are user-defined. Metadata-only in 0.8 —
// stripped from TypeScript output, not yet transitively enforced.
// Use them the same way you use uses {}: document intent, prepare for
// enforcement in a future version.

// lookupCache / writeCache are intentionally stubbed — the reads/writes
// annotations are metadata-only in 0.8 (no body-shape verification yet),
// so the bodies don't need to actually touch a cache. They illustrate the
// declarative shape; a real implementation would back this with a Map or
// external KV store and the same annotations would still apply.
fn lookupCache(id: string) reads { cache } -> string | undefined =
  pure { undefined }

fn writeCache(id: string, value: string) writes { cache } -> void { }

async fn fetchFromDb(id: string) uses { net } reads { db } -> Promise<Result<string, string>> {
  const res = await http.get(`https://api.example.com/users/${id}`);
  if (!isOk(res)) return err("not found");
  return ok(id);
}

async fn loadUser(id: string) uses { net } reads { cache, db } writes { cache } -> Promise<Result<string, string>> {
  const cached = lookupCache(id);
  if (cached !== undefined) return ok(cached);
  const result = await fetchFromDb(id);
  if (isOk(result)) writeCache(id, result.value);
  return result;
}

export { loadUser };
