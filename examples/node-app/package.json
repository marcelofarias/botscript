{
  "name": "node-app",
  "version": "0.0.0",
  "private": true,
  "description": "Tiny CLI showing botscript end-to-end on Node.",
  "type": "module",
  "scripts": {
    "build": "node ../../packages/cli/dist/cli.js build src && node ../../packages/cli/dist/cli.js build tests",
    "dev": "pnpm build && tsx src/main.ts",
    "test": "pnpm build && vitest run",
    "clean": "rm -f src/*.ts tests/*.ts"
  },
  "dependencies": {
    "@mbfarias/botscript-runtime": "workspace:*"
  },
  "devDependencies": {
    "@mbfarias/botscript-cli": "workspace:*",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
