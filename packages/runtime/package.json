{
  "name": "@mbfarias/botscript-runtime",
  "version": "0.2.1",
  "description": "Runtime helpers for botscript: Result, Option, match, capability registry.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "import": "./dist/fs.js"
    }
  },
  "license": "MIT",
  "author": "Marcelo Farias",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelofarias/botscript.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/marcelofarias/botscript#readme",
  "keywords": [
    "botscript",
    "result",
    "option",
    "match",
    "capabilities"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
