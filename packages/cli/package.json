{
  "name": "@mbfarias/botscript-cli",
  "version": "0.5.0",
  "description": "botscript command-line: build *.bs files to *.ts, print the primer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "botscript": "./dist/cli.js",
    "bs": "./dist/cli.js"
  },
  "license": "MIT",
  "author": "Marcelo Farias",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelofarias/botscript.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/marcelofarias/botscript#readme",
  "keywords": [
    "botscript",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mbfarias/botscript-compiler": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
