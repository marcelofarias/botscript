{
  "name": "@botscript/cli",
  "version": "0.1.0",
  "description": "botscript command-line: build *.bs files to *.ts, print the primer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "botscript": "./dist/cli.js",
    "bs": "./dist/cli.js"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@botscript/compiler": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
