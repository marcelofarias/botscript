{
  "name": "@mbfarias/botscript-compiler",
  "version": "0.5.0",
  "description": "botscript compiler: transforms .bs source to TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primer": {
      "types": "./dist/primer.d.ts",
      "import": "./dist/primer.js"
    }
  },
  "license": "MIT",
  "author": "Marcelo Farias",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelofarias/botscript.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/marcelofarias/botscript#readme",
  "keywords": [
    "botscript",
    "compiler",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@mbfarias/botscript-runtime": "workspace:*",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@mbfarias/botscript-runtime": "^0.5.0"
  }
}
