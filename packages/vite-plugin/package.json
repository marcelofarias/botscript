{
  "name": "@mbfarias/botscript-vite-plugin",
  "version": "0.1.0",
  "description": "Vite plugin for botscript: transforms *.bs files to TypeScript at build time.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "author": "Marcelo Farias",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelofarias/botscript.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/marcelofarias/botscript#readme",
  "keywords": ["botscript", "vite", "vite-plugin"],
  "publishConfig": { "access": "public" },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mbfarias/botscript-compiler": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  }
}
